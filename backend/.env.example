# Copia este archivo como .env para desarrollo local. Ninguna variable es obligatoria en local.
DEBUG=true
DJANGO_SECRET_KEY=change-me
# Debe ser idéntica a la del servicio optimizer.
JWT_SIGNING_KEY=change-me-use-a-long-random-value
# Postgres (Neon). Si se omite, se usa SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
OPTIMIZER_URL=http://localhost:8001
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=http://localhost:5500
